# Configuration du serveur
PORT=3001
NODE_ENV=development

# Configuration de la base de données SQLite
DB_PATH=database.sqlite

# Configuration CORS
CORS_ORIGIN=http://localhost:3000

# Configuration JWT
JWT_SECRET=your-secret-key-change-in-production

# URL du frontend (pour les liens dans les emails)
FRONTEND_URL=http://localhost:3000

# Configuration SMTP pour l'envoi d'emails
# Exemple avec Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre-email@gmail.com
# SMTP_PASSWORD=votre-mot-de-passe-application
# SMTP_FROM=noreply@troc-services.com

# Exemple avec SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=votre-api-key-sendgrid
# SMTP_FROM=noreply@troc-services.com

# Exemple avec Mailgun:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@votre-domaine.mailgun.org
# SMTP_PASSWORD=votre-mot-de-passe-mailgun
# SMTP_FROM=noreply@troc-services.com

# Pour le développement, vous pouvez utiliser un service comme Mailtrap (https://mailtrap.io)
# qui capture les emails sans les envoyer réellement:
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=votre-username-mailtrap
# SMTP_PASSWORD=votre-password-mailtrap
# SMTP_FROM=noreply@troc-services.com

# Note: Si les variables SMTP ne sont pas configurées, les emails ne seront pas envoyés
# mais l'application continuera de fonctionner normalement (avec des avertissements dans les logs)

